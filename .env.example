# 이 파일을 .env.local 로 복사해서 채우세요. .env.local 은 커밋되지 않습니다.

# --- Supabase -----------------------------------------------------------------
# 프로젝트 설정 > API 에서 가져옵니다. 리전은 Northeast Asia (Seoul) 을 쓰세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 이 키는 RLS 를 우회합니다. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
# 브라우저로 새어 나가면 학교 전체 데이터가 노출됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# --- 암호화 -------------------------------------------------------------------
# 교직원이 등록한 Gemini API 키를 암호화할 때 씁니다.
#   openssl rand -base64 32
# 이 값을 바꾸면 저장된 키를 모두 다시 등록해야 합니다.
GEMINI_KEY_ENCRYPTION_KEY=

# --- 선택 ---------------------------------------------------------------------
# 수업 도구함에서 쓸 모델. 무료 한도 정책이 바뀌면 여기만 고치면 됩니다.
GEMINI_MODEL=gemini-2.5-flash

# 나이스 학사일정 연동 (open.neis.go.kr 에서 무료 발급)
NEIS_API_KEY=
NEIS_SCHOOL_CODE=
NEIS_OFFICE_CODE=

# 유튜브 자료 찾기
YOUTUBE_API_KEY=

# 데모 데이터를 넣을 때만 true. 운영에서는 절대 켜지 마세요.
SEED_DEMO=false
