# 이 파일을 .env.local 로 복사해서 채우세요. .env.local 은 커밋되지 않습니다.

# --- Supabase -----------------------------------------------------------------
# 프로젝트 설정 > API 에서 가져옵니다. 리전은 Northeast Asia (Seoul) 을 쓰세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 이 키는 RLS 를 우회합니다. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
# 브라우저로 새어 나가면 학교 전체 데이터가 노출됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# --- 암호화 -------------------------------------------------------------------
# 교직원이 등록한 Gemini API 키를 암호화할 때 씁니다.
#   openssl rand -base64 32
# 이 값을 바꾸면 저장된 키를 모두 다시 등록해야 합니다.
GEMINI_KEY_ENCRYPTION_KEY=

# --- 선택 ---------------------------------------------------------------------
# 수업 도구함에서 쓸 모델. 무료 한도 정책이 바뀌면 여기만 고치면 됩니다.
GEMINI_MODEL=gemini-2.5-flash

# 나이스 학사일정 연동 (open.neis.go.kr 에서 무료 발급)
NEIS_API_KEY=
NEIS_SCHOOL_CODE=
NEIS_OFFICE_CODE=

# 유튜브 자료 찾기(수업 자료 찾기) 키는 여기 없습니다 — Gemini 키와 같은 방식으로
# 학교 관리 화면(학교 공용) 또는 내 설정(개인)에서 등록합니다. 여러 학교가 한
# 배포를 같이 쓸 수 있어 서버 환경변수로 전체가 공유하는 키는 두지 않습니다.

# 데모 데이터를 넣을 때만 true. 운영에서는 절대 켜지 마세요.
SEED_DEMO=false

# 배포한 사이트에서 데모 데이터를 만들 때 쓰는 열쇠입니다.
# 값이 없으면 /api/demo/seed 가 아예 동작하지 않습니다 (기본은 잠김).
# 데모를 다 만든 뒤에는 지우는 편이 안전합니다.
#   openssl rand -hex 16
SEED_SECRET=

# 파기 배치(/api/cron/purge)와 데모 초기화 배치(/api/cron/reset-demo)를
# 외부에서 못 부르게 막습니다. Vercel Cron 이 자동으로 이 값을 붙여서 부릅니다.
CRON_SECRET=

# 플랫폼 최고관리자 이메일. 콤마로 여러 명 가능.
# 여기 적힌 이메일로 로그인하면 (학교 profiles 가 없어도) /platform 에서
# 새 학교를 열고, 기존 학교에 관리자를 지정할 수 있습니다.
# 로그인하려면 Supabase 대시보드 > Authentication > Add User 로 이
# 이메일의 Auth 계정을 먼저 만들어야 합니다 (Auto Confirm 체크).
PLATFORM_ADMIN_EMAILS=
